---
import { PARTNERS } from '../shared/partners';
const { title = 'Chủ đầu tư đối tác' } = Astro.props as { title?: string };
---
<section class="partners">
  <h2>{title}</h2>
  <p class="muted">Các chủ đầu tư Di Trú Síp đang làm việc cùng. Bấm vào logo để mở website của công ty.</p>
  <div class="pgrid">
    {PARTNERS.map((p) => (
      <a href={p.url} target="_blank" rel="noopener" title={p.name} aria-label={p.name}>
        <img src={`/img/partners/${p.id}.png`} alt={p.name} loading="lazy" class={p.id === 'luma' ? 'tall' : undefined} />
      </a>
    ))}
  </div>
</section>
<style>
  .partners { margin-top: 40px; }
  .partners h2 { margin-bottom: 4px; }
  .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-top: 14px; }
  .pgrid a { display: flex; align-items: center; justify-content: center; height: 92px; padding: 14px 18px; background: #fff; border: 1px solid var(--line); border-radius: 14px; transition: border-color .15s, transform .15s; }
  .pgrid a:hover { border-color: var(--blue, #2A9DAE); transform: translateY(-2px); }
  .pgrid img { max-width: 100%; max-height: 44px; object-fit: contain; }
  .pgrid img.tall { max-height: 70px; }
  @media (max-width: 520px) { .pgrid { grid-template-columns: repeat(3, 1fr); gap: 8px; } .pgrid a { height: 72px; padding: 10px; } .pgrid img { max-height: 32px; } .pgrid img.tall { max-height: 54px; } }
</style>
