---
import Base from '../../layouts/Base.astro';
import MemberGate from '../../components/MemberGate.astro';
import { getGuides, type GuidePreview } from '../../lib/db';
// Phần xem trước (tiêu đề, ảnh, đoạn mở đầu) dựng sẵn; các bước, giấy tờ, nguồn chỉ thành viên tải được (bảng guides, migration 0012).
export async function getStaticPaths() { return (await getGuides()).map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props as { g: GuidePreview };
const img = `https://ditrusip.com${g.image}`;
const others = (await getGuides()).filter((x) => x.slug !== g.slug);
---
<Base title={`${g.title} ở Síp: các bước, giấy tờ | EUWay - Di Trú Síp`} description={g.short} image={img} type="article">
  <article class="wrap guide">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › <a href="/an-cu/">An cư</a> › {g.title}</p>
    <img class="hero" src={g.image} alt="" width="900" height="450" />
    <h1>{g.title}</h1>
    <p class="note" style="background:#F2E3C6;border-radius:12px;padding:12px 16px;color:#0B3C5D;max-width:70ch">⚠️ Đây là kinh nghiệm cá nhân của đội ngũ. Thông tin có thể thay đổi tùy khu vực và thời điểm, tốt nhất anh chị liên hệ trực tiếp cơ quan liên quan hoặc đội ngũ để được xác nhận.</p>
    <p class="lead">{g.intro}</p>

    <MemberGate title="Xem đầy đủ hướng dẫn từng bước" points={['Các bước làm, giấy tờ cần chuẩn bị', 'Địa chỉ, số điện thoại, giờ mở cửa ở Paphos', 'Kinh nghiệm thực tế của đội ngũ và nguồn chính thức']} />
    <div id="full" data-slug={g.slug}></div>

    <h2>Hướng dẫn khác</h2>
    <ul class="more">{others.map((x) => <li><a href={`/an-cu/${x.slug}/`}>{x.title}</a></li>)}</ul>
  </article>
  <script>
    import { whenMember, sb, esc } from '../../lib/member';
    whenMember(async () => {
      const box = document.getElementById('full')!;
      const { data: g } = await sb.from('guides').select('steps, sections, tip, sources, checked').eq('slug', box.dataset.slug!).maybeSingle();
      if (!g) return;
      let h = '<h2>Các bước</h2><ol class="steps">' + (g.steps as any[]).map((s) => `<li><h3>${esc(s.title)}</h3><p>${esc(s.body)}</p></li>`).join('') + '</ol>';
      for (const sec of g.sections as any[]) h += `<section class="card"><h2>${esc(sec.title)}</h2><ul>${sec.points.map((p: string) => `<li>${esc(p)}</li>`).join('')}</ul></section>`;
      if (g.tip) h += `<div class="card tip"><p>${esc(g.tip)}</p><a class="btn" href="/contact-us/">Nhờ đội ngũ hỗ trợ</a> <a class="btn alt" href="#tro-ly" id="ask-mia">Hỏi Mia</a></div>`;
      h += '<h2>Nguồn tham khảo</h2><ul class="src">' + (g.sources as any[]).map((s) => `<li><a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.label)}</a></li>`).join('') + '</ul>';
      h += `<p class="note">Kiểm tra ngày ${esc(g.checked)}. Đây là kinh nghiệm cá nhân của đội ngũ. Thông tin có thể thay đổi tùy khu vực và thời điểm, tốt nhất anh chị liên hệ trực tiếp cơ quan liên quan hoặc đội ngũ để được xác nhận. Đây là thông tin tham khảo, không phải tư vấn pháp lý.</p>`;
      box.innerHTML = h;
      document.getElementById('ask-mia')?.addEventListener('click', (e) => { e.preventDefault(); document.getElementById('ai-open')?.click(); });
    });
  </script>
  <style is:global>
    .guide { max-width: 820px; }
    .guide .hero { width: 100%; height: auto; aspect-ratio: 2/1; object-fit: cover; border-radius: 18px; display: block; margin-bottom: 18px; }
    .guide .lead { font-size: 18px; line-height: 1.6; }
    .guide .steps { list-style: none; counter-reset: s; padding: 0; margin: 0 0 24px; }
    .guide .steps li { counter-increment: s; position: relative; padding: 0 0 18px 52px; border-left: 2px solid var(--line); margin-left: 17px; }
    .guide .steps li:last-child { border-left-color: transparent; }
    .guide .steps li::before { content: counter(s); position: absolute; left: -18px; top: -2px; width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .guide .steps h3 { margin: 2px 0 4px; font-size: 18px; }
    .guide .steps p { margin: 0; line-height: 1.6; }
    .guide .card { margin: 16px 0; }
    .guide .card h2 { margin-top: 0; font-size: 20px; }
    .guide .card ul, .guide .src, .guide .more { padding-left: 18px; }
    .guide .card li { margin: 8px 0; line-height: 1.55; }
    .guide .tip { background: var(--sand-soft); }
    .guide .tip p { margin-top: 0; }
  </style>
</Base>
