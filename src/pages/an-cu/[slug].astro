---
import Base from '../../layouts/Base.astro';
import { GUIDES, type Guide } from '../../shared/guides';
export function getStaticPaths() { return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props as { g: Guide };
const img = `https://ditrusip.com${g.image}`;
const others = GUIDES.filter((x) => x.slug !== g.slug);
const [d, m, y] = g.checked.split('/');
const jsonld = {
  '@context': 'https://schema.org', '@type': 'HowTo', name: g.title, description: g.short, image: img,
  dateModified: `${y}-${m}-${d}`, step: g.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.body })),
};
---
<Base title={`${g.title} ở Síp: các bước, giấy tờ | EUWay - Di Trú Síp`} description={`${g.short} Cập nhật ${g.checked}.`} image={img} type="article" jsonld={jsonld}>
  <article class="wrap guide">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › <a href="/an-cu/">An cư</a> › {g.title}</p>
    <img class="hero" src={g.image} alt="" width="900" height="450" />
    <h1>{g.title}</h1>
    <p class="lead">{g.intro}</p>

    <h2>Các bước</h2>
    <ol class="steps">
      {g.steps.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}
    </ol>

    {g.sections.map((sec) => (
      <section class="card"><h2>{sec.title}</h2><ul>{sec.points.map((p) => <li>{p}</li>)}</ul></section>
    ))}

    {g.tip && <div class="card tip"><p>{g.tip}</p><a class="btn" href="/contact-us/">Nhờ đội ngũ hỗ trợ</a> <a class="btn alt" href="#tro-ly" onclick="document.getElementById('ai-open')?.click();return false;">Hỏi Mia</a></div>}

    <h2>Nguồn tham khảo</h2>
    <ul class="src">{g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    <p class="note">Kiểm tra ngày {g.checked}. Thủ tục, lệ phí và giờ mở cửa có thể thay đổi; hỏi lại cơ quan liên quan trước khi đi. Đây là thông tin tham khảo, không phải tư vấn pháp lý.</p>

    <h2>Hướng dẫn khác</h2>
    <ul class="more">{others.map((x) => <li><a href={`/an-cu/${x.slug}/`}>{x.title}</a></li>)}</ul>
  </article>
  <style>
    .guide { max-width: 820px; }
    .guide .hero { width: 100%; height: auto; aspect-ratio: 2/1; object-fit: cover; border-radius: 18px; display: block; margin-bottom: 18px; }
    .guide .lead { font-size: 18px; line-height: 1.6; }
    .steps { list-style: none; counter-reset: s; padding: 0; margin: 0 0 24px; }
    .steps li { counter-increment: s; position: relative; padding: 0 0 18px 52px; border-left: 2px solid var(--line); margin-left: 17px; }
    .steps li:last-child { border-left-color: transparent; }
    .steps li::before { content: counter(s); position: absolute; left: -18px; top: -2px; width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .steps h3 { margin: 2px 0 4px; font-size: 18px; }
    .steps p { margin: 0; line-height: 1.6; }
    .guide .card { margin: 16px 0; }
    .guide .card h2 { margin-top: 0; font-size: 20px; }
    .guide .card ul, .guide .src, .guide .more { padding-left: 18px; }
    .guide .card li { margin: 8px 0; line-height: 1.55; }
    .tip { background: var(--sandSoft, #F6F0E4); }
    .tip p { margin-top: 0; }
  </style>
</Base>
