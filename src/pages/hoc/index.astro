---
import Base from '../../layouts/Base.astro';
---
<Base title="Khu Học | EUWay - Di Trú Síp" description="Khu học dành cho thành viên Di Trú Síp: học tiếng Hy Lạp, luyện trắc nghiệm thi quốc tịch Síp và lý thuyết bằng lái xe." noindex>
  <div class="wrap narrow">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › Khu Học</p>
    <h1>Khu Học</h1>
    <p class="muted">Dành cho gia đình người Việt đang sống hoặc chuẩn bị sang Síp. Tài khoản do đội ngũ Di Trú Síp duyệt mới vào học được.</p>

    <div id="st" class="card state" aria-live="polite"><p class="muted">Đang kiểm tra tài khoản…</p></div>

    <div class="grid courses">
      <a class="card course" id="c-greek" href="/hoc/tieng-hy-lap/">
        <span class="chip">Đang mở · bản thử nghiệm</span>
        <h3>Học tiếng Hy Lạp</h3>
        <p>Từ bảng chữ cái tới trình độ thi chứng chỉ, mỗi ngày 30 phút: nghe, nói, đọc, viết, kèm kiến thức về Síp.</p>
      </a>
      <div class="card course soon">
        <span class="chip off">Sắp có</span>
        <h3>Trắc nghiệm thử thi quốc tịch</h3>
        <p>Luyện câu hỏi về chính trị, xã hội và văn hóa Síp theo đề cương của Sở Khảo thí.</p>
      </div>
      <div class="card course soon">
        <span class="chip off">Sắp có</span>
        <h3>Học bằng lái và trắc nghiệm thử</h3>
        <p>Lý thuyết lái xe tại Síp và bài thi thử.</p>
      </div>
    </div>
    <p class="note">Nội dung học mang tính tham khảo và đang được soát lại; thông tin chính thức về các kỳ thi do cơ quan tổ chức thi công bố.</p>
  </div>

  <style>
    .state { margin: 18px 0; }
    .state :global(h3) { margin-top: 0; }
    .state :global(textarea) { width: 100%; min-height: 70px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; font: inherit; margin: 8px 0 12px; }
    .state :global(.err) { color: #B3261E; font-size: 14px; }
    .courses { margin: 8px 0 24px; }
    .course { text-decoration: none; color: var(--ink); display: block; }
    .course h3 { margin: 10px 0 6px; }
    .course p { margin: 0; font-size: 15px; color: var(--muted); }
    a.course:hover { border-color: var(--blue); }
    .soon { opacity: .7; }
    .chip.off { background: var(--sand); color: var(--muted); }
  </style>

  <script>
    import { hocState, requestAccess } from '../../lib/hoc';
    import { loginHref } from '../../lib/member';
    const st = document.getElementById('st')!;
    const greek = document.getElementById('c-greek') as HTMLAnchorElement;

    async function render() {
      const s = await hocState();
      const hi = s.name ? `Xin chào ${s.name.replace(/[<>&"]/g, '')}. ` : '';
      if (s.status === 'guest') {
        greek.href = loginHref('/hoc/');
        st.innerHTML = `<h3>Đăng nhập để xin vào học</h3><p>Anh chị đăng ký thành viên miễn phí bằng email, sau đó gửi yêu cầu vào Khu Học tại trang này.</p><p><a class="btn orange" href="${loginHref('/hoc/')}">Đăng ký / Đăng nhập</a></p>`;
      } else if (s.status === 'none') {
        greek.href = '#st';
        st.innerHTML = `<h3>${hi}Gửi yêu cầu vào Khu Học</h3><p>Đội ngũ xem và duyệt từng tài khoản. Anh chị có thể ghi vài dòng về mình (không bắt buộc).</p><textarea id="note" maxlength="500" placeholder="Ví dụ: gia đình tôi đang ở Paphos, muốn học tiếng Hy Lạp để thi quốc tịch."></textarea><p class="err" id="err" role="alert"></p><button class="btn orange" id="req" type="button">Gửi yêu cầu</button>`;
        document.getElementById('req')!.onclick = async (e) => {
          const b = e.currentTarget as HTMLButtonElement; b.disabled = true;
          const err = await requestAccess((document.getElementById('note') as HTMLTextAreaElement).value);
          if (err) { document.getElementById('err')!.textContent = err; b.disabled = false; return; }
          render();
        };
      } else if (s.status === 'pending') {
        greek.href = '#st';
        st.innerHTML = `<h3>${hi}Yêu cầu của anh chị đang chờ duyệt</h3><p>Đội ngũ sẽ duyệt trong thời gian sớm nhất. Cần gấp, anh chị nhắn WhatsApp/Zalo +357 94 100 091.</p>`;
      } else if (s.status === 'rejected') {
        greek.href = '#st';
        st.innerHTML = `<h3>Tài khoản chưa được mở Khu Học</h3><p>Anh chị liên hệ đội ngũ qua WhatsApp/Zalo +357 94 100 091 để được hỗ trợ.</p>`;
      } else {
        st.innerHTML = `<h3>${hi}Tài khoản đã được duyệt</h3><p><a class="btn" href="/hoc/tieng-hy-lap/">Vào học tiếng Hy Lạp</a>${s.staff ? ' <a class="btn alt" href="/hoc/quan-tri/">Duyệt tài khoản</a>' : ''}</p>`;
      }
    }
    render();
  </script>
</Base>
