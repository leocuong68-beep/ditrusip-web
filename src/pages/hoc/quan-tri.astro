---
import Base from '../../layouts/Base.astro';
---
<Base title="Duyệt tài khoản Khu Học | Di Trú Síp" noindex>
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › <a href="/hoc/">Khu Học</a> › Duyệt tài khoản</p>
    <h1>Duyệt tài khoản Khu Học</h1>
    <div id="adm"><p class="muted">Đang tải…</p></div>
  </div>
  <style is:global>
    .wa-float, .ai-open, .ai-tease { display: none !important; }
    #adm table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; font-size: 15px; display: block; overflow-x: auto; }
    #adm th, #adm td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    #adm th { background: var(--aqua); color: var(--navy); white-space: nowrap; }
    #adm td.act { white-space: nowrap; }
    #adm button { font: inherit; font-size: 14px; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1.5px solid var(--navy); background: #fff; color: var(--navy); cursor: pointer; margin-right: 6px; }
    #adm button.ok { background: var(--ok); border-color: var(--ok); color: #fff; }
    #adm .st-pending { color: var(--warn); font-weight: 600; }
    #adm .st-approved { color: var(--ok); font-weight: 600; }
    #adm .st-rejected { color: #B3261E; font-weight: 600; }
    #adm h2 { margin-top: 28px; }
  </style>
  <script>
    import { sb, esc, loginHref } from '../../lib/member';
    import { hocState } from '../../lib/hoc';
    const box = document.getElementById('adm')!;
    const LABEL: Record<string, string> = { pending: 'Chờ duyệt', approved: 'Đã duyệt', rejected: 'Từ chối' };
    const fmt = (s: string | null) => (s ? new Date(s).toLocaleString('vi-VN', { timeZone: 'Asia/Nicosia', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '');

    async function load() {
      const { data: acc, error } = await sb.from('hoc_access').select('user_id, status, note, requested_at, decided_at').order('requested_at', { ascending: false });
      if (error) { box.innerHTML = '<p class="muted">Chưa tải được danh sách.</p>'; return; }
      const ids = (acc ?? []).map((a) => a.user_id);
      const { data: profs } = ids.length ? await sb.from('profiles').select('id, full_name, email, phone').in('id', ids) : { data: [] as any[] };
      const by = new Map((profs ?? []).map((p: any) => [p.id, p]));
      const row = (a: any) => {
        const p: any = by.get(a.user_id) ?? {};
        const btn = (st: string, label: string, cls = '') => (a.status === st ? '' : `<button class="${cls}" data-u="${a.user_id}" data-s="${st}">${label}</button>`);
        return `<tr><td><b>${esc(p.full_name || '(chưa có tên)')}</b><br>${esc(p.email || '')}<br>${esc(p.phone || '')}</td><td>${esc(a.note || '')}</td><td>${fmt(a.requested_at)}</td><td><span class="st-${a.status}">${LABEL[a.status]}</span>${a.decided_at ? '<br><small>' + fmt(a.decided_at) + '</small>' : ''}</td><td class="act">${btn('approved', 'Duyệt', 'ok')}${btn('rejected', a.status === 'approved' ? 'Thu hồi' : 'Từ chối')}</td></tr>`;
      };
      const table = (list: any[]) => (list.length ? `<table><tr><th>Thành viên</th><th>Ghi chú</th><th>Gửi lúc</th><th>Trạng thái</th><th></th></tr>${list.map(row).join('')}</table>` : '<p class="muted">Không có.</p>');
      const pend = (acc ?? []).filter((a) => a.status === 'pending'), rest = (acc ?? []).filter((a) => a.status !== 'pending');
      box.innerHTML = `<h2>Chờ duyệt (${pend.length})</h2>${table(pend)}<h2>Đã xử lý (${rest.length})</h2>${table(rest)}<p class="note" style="margin-top:20px">Nhân viên (staff) luôn vào học được, không cần duyệt. Thu hồi là chuyển về "Từ chối"; tiến độ học của thành viên vẫn được giữ.</p>`;
      box.querySelectorAll<HTMLButtonElement>('button[data-u]').forEach((b) => (b.onclick = async () => {
        b.disabled = true;
        const { error } = await sb.from('hoc_access').update({ status: b.dataset.s }).eq('user_id', b.dataset.u!);
        if (error) { alert('Chưa lưu được. Thử lại sau.'); b.disabled = false; return; }
        load();
      }));
    }

    hocState().then((s) => {
      if (s.status === 'guest') { location.replace(loginHref('/hoc/quan-tri/')); return; }
      if (!s.staff) { box.innerHTML = '<p>Trang này dành cho nhân viên Di Trú Síp. <a href="/hoc/">Về Khu Học</a></p>'; return; }
      load();
    });
  </script>
</Base>
