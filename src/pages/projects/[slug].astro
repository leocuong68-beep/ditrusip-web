---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getListings, priceLabel, fixLinks, type Listing } from '../../lib/db';
export async function getStaticPaths() {
  return (await getListings()).map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Listing };
const others = (await getListings()).filter((x) => x.id !== l.id && x.kind === l.kind).slice(0, 3);
// Nội dung cũ đã có ảnh trong thư viện; bỏ ảnh trong thân bài, hiện thư viện riêng.
const body = fixLinks((l.content_html ?? '').replace(/<img[^>]*>/g, ''));
const gallery = (l.gallery?.length ? l.gallery : [l.image_url]).filter(Boolean) as string[];
---
<Base title={l.seo_title ?? `${l.title} | Di Trú Síp`} description={l.seo_description} image={l.image_url}>
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › <a href="/projects/">Dự án BĐS</a> › {l.title}</p>
    <h1>{l.title}</h1>
    <p><span class="chip">{l.kind === 'villa' ? 'Biệt thự' : 'Căn hộ'} · {l.area}</span></p>
    <div class="gal">
      {gallery.map((src, i) => <a href={src} target="_blank" rel="noopener" class={i === 0 ? 'main' : ''}><img src={src} alt={`${l.title} — ảnh ${i + 1}`} loading={i < 1 ? 'eager' : 'lazy'} /></a>)}
    </div>
    <style>
      .gal { display: grid; gap: 8px; grid-template-columns: repeat(4, 1fr); }
      .gal a.main { grid-column: span 2; grid-row: span 2; }
      .gal img { width: 100%; height: 100%; aspect-ratio: 3/2; object-fit: cover; display: block; }
      @media (max-width: 700px) {
        .gal { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
        .gal a { flex: 0 0 86%; scroll-snap-align: start; }
      }
    </style>
    <div style="display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));margin-top:24px">
      <div class="prose" set:html={body} />
      <aside>
        <div class="card">
          <b style="font-size:22px;color:var(--navy)">{priceLabel(l)}</b>
          <ul style="padding-left:18px">
            {l.bedrooms && <li>{l.bedrooms} phòng ngủ</li>}
            {l.size_m2 && <li>Diện tích: {l.size_m2}</li>}
            {l.handover && <li>Bàn giao: {l.handover}</li>}
          </ul>
          <p style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn" href="/chi-phi/">Tính tổng chi phí</a></p>
          <p class="note">Giá, tiến độ do chủ đầu tư cung cấp và có thể thay đổi. Dự án đang xây có rủi ro chậm bàn giao.</p>
        </div>
        <div style="margin-top:16px"><ContactForm /></div>
      </aside>
    </div>
    {others.length > 0 && <><h2>Dự án tương tự</h2><div class="grid">{others.map((x) => <ListingCard l={x} />)}</div></>}
  </div>
</Base>
