---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getListings } from '../../lib/db';
const listings = await getListings();
const areas = [...new Set(listings.map((l) => l.area))];
---
<Base title="Dự Án Bất Động Sản Paphos Cho Diện Thường Trú 6(2) | Di Trú Síp" description={`${listings.length} dự án căn hộ và biệt thự tại Paphos, Síp, giá từ 300.000 € + VAT, phù hợp hồ sơ thường trú diện đầu tư bất động sản.`}>
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › Dự án BĐS</p>
    <h1>Dự án bất động sản</h1>
    <p class="muted">{listings.length} dự án tại khu Paphos. Giá chủ đầu tư công bố, chưa gồm VAT nếu ghi “+ VAT”.</p>
    <form id="filter" class="card" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-bottom:20px">
      <label>Loại<br /><select name="kind"><option value="">Tất cả</option><option value="apartment">Căn hộ</option><option value="villa">Biệt thự</option></select></label>
      <label>Khu vực<br /><select name="area"><option value="">Tất cả</option>{areas.map((a) => <option>{a}</option>)}</select></label>
      <label>Giá tối đa<br /><select name="max"><option value="">Không giới hạn</option><option value="350000">350.000 €</option><option value="400000">400.000 €</option><option value="500000">500.000 €</option><option value="700000">700.000 €</option></select></label>
    </form>
    <div class="grid" id="list">{listings.map((l) => <div data-kind={l.kind} data-area={l.area} data-price={l.price_from}><ListingCard l={l} /></div>)}</div>
    <p id="empty" class="muted" hidden>Chưa có dự án hợp tiêu chí. Anh chị nhắn đội ngũ để được báo khi có căn mới.</p>
    <p class="note" style="margin-top:24px">Giá và tiến độ do chủ đầu tư cung cấp, có thể thay đổi. Mua nhà đang xây có rủi ro chậm bàn giao; anh chị nên để luật sư kiểm tra sổ đỏ, giấy phép xây dựng và hợp đồng trước khi đặt cọc.</p>
  </div>
  <style>#filter select{padding:9px 12px;border:1px solid var(--line);border-radius:10px;font:inherit;background:#fff;margin-top:4px}</style>
  <script>
    const f = document.getElementById('filter') as HTMLFormElement;
    f.addEventListener('change', () => {
      const d = new FormData(f); let n = 0;
      document.querySelectorAll<HTMLElement>('#list > div').forEach((el) => {
        const ok = (!d.get('kind') || el.dataset.kind === d.get('kind')) && (!d.get('area') || el.dataset.area === d.get('area')) && (!d.get('max') || Number(el.dataset.price) <= Number(d.get('max')));
        el.style.display = ok ? '' : 'none'; if (ok) n++;
      });
      document.getElementById('empty')!.hidden = n > 0;
    });
  </script>
</Base>
