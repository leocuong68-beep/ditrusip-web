---
import Base from '../layouts/Base.astro';
import LegalBody from '../components/LegalBody.astro';
import { getSetting } from '../lib/db';
import { PRIVACY, PRIVACY_DATE } from '../shared/privacy';
const contact = await getSetting('contact');
---
<Base title="Chính Sách Quyền Riêng Tư | Di Trú Síp" description="Cách Di Trú Síp thu thập, sử dụng và lưu trữ dữ liệu cá nhân trên website, ứng dụng và trợ lý Mia.">
  <div class="wrap narrow prose">
    <p class="breadcrumb"><a href="/">Trang chủ</a> › Chính sách quyền riêng tư</p>
    <h1>Chính sách quyền riêng tư</h1>
    <p class="muted">Có hiệu lực từ ngày {PRIVACY_DATE}. Áp dụng cho website ditrusip.com, ứng dụng Di Trú Síp và trợ lý Mia.</p>
    {PRIVACY.map(([h, b], i) => <><h2>{i + 1}. {h}</h2><LegalBody text={b} /></>)}
    <h2>{PRIVACY.length + 1}. Liên hệ</h2>
    <p>Email <a href={`mailto:${contact.email}`}>{contact.email}</a> · WhatsApp/Zalo {contact.phone_cy}. Xem thêm <a href="/dieu-khoan/">Điều khoản sử dụng</a> và <a href="/xoa-tai-khoan/">cách xoá tài khoản</a>.</p>
  </div>
</Base>
