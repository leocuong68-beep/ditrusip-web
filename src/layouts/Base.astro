---
import { getSetting } from '../lib/db';
import Assistant from '../components/Assistant.astro';
interface Props { title: string; description?: string | null; image?: string | null; type?: 'website' | 'article'; noindex?: boolean; jsonld?: object }
const { title, description, image, type = 'website', noindex = false, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const contact = await getSetting('contact');
const social = await getSetting('social');
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Di Trú Síp', founder: { '@type': 'Person', name: 'Đặng Thái Cường' },
  url: 'https://ditrusip.com', email: contact.email, telephone: contact.phone_cy,
  address: { '@type': 'PostalAddress', addressLocality: 'Paphos', addressCountry: 'CY' },
  sameAs: [social.youtube, social.facebook].filter(Boolean),
};
const nav = [
  ['/ve-chung-toi/', 'Về chúng tôi'], ['/dich-vu/', 'Dịch vụ'], ['/projects/', 'Dự án BĐS'],
  ['/chi-phi/', 'Chi phí 6(2)'], ['/blog/', 'Tin tức'], ['/contact-us/', 'Liên hệ'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Di Trú Síp" />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Be+Vietnam+Pro:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <style is:global>
    :root {
      --navy: #0E5A78; --blue: #1C9DB0; --dome: #2457A6; --aqua: #DDF2F3; --sand: #EDE3D1; --sand-soft: #F7F1E6;
      --orange: #E07158; --ink: #14313E; --muted: #5E7380; --line: #E6ECEC; --bg: #F8F6F1; --card: #FFFFFF;
      --ok: #2E7D5B; --warn: #B7791F;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.65 'Be Vietnam Pro', system-ui, sans-serif; }
    h1, h2, h3, h4 { font-family: 'Lora', Georgia, serif; color: var(--navy); line-height: 1.25; margin: 1.4em 0 .5em; }
    h1 { font-size: clamp(28px, 5vw, 42px); font-weight: 700; margin-top: 0; }
    h2 { font-size: clamp(22px, 3.4vw, 30px); font-weight: 600; }
    h3 { font-size: 20px; font-weight: 600; }
    a { color: var(--dome); }
    img { max-width: 100%; height: auto; border-radius: 10px; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
    .narrow { max-width: 760px; }
    header.site { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
    header.site .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
    .brand { font-family: 'Lora', serif; font-weight: 700; font-size: 22px; color: var(--navy); text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .brand span { color: var(--blue); }
    nav.main { display: flex; gap: 4px; flex-wrap: wrap; }
    nav.main a { text-decoration: none; color: var(--ink); padding: 8px 12px; border-radius: 999px; font-weight: 500; font-size: 15px; }
    nav.main a[aria-current] , nav.main a:hover { background: var(--aqua); color: var(--navy); }
    details.menu { display: none; }
    @media (max-width: 900px) {
      nav.main { display: none; }
      details.menu { display: block; position: relative; }
      details.menu summary { list-style: none; cursor: pointer; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; font-weight: 600; color: var(--navy); }
      details.menu summary::-webkit-details-marker { display: none; }
      details.menu nav { position: absolute; right: 0; top: 46px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px; min-width: 220px; box-shadow: 0 10px 30px rgba(14,90,120,.12); display: flex; flex-direction: column; }
      details.menu nav a { padding: 10px 12px; text-decoration: none; color: var(--ink); border-radius: 10px; }
    }
    .btn { display: inline-block; background: var(--navy); color: #fff; text-decoration: none; padding: 12px 22px; border-radius: 999px; font-weight: 600; border: 0; cursor: pointer; font: inherit; font-weight: 600; }
    .btn.alt { background: #fff; color: var(--navy); border: 1.5px solid var(--navy); }
    .btn.orange { background: var(--orange); }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
    .grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .muted { color: var(--muted); }
    .chip { display: inline-block; background: var(--aqua); color: var(--navy); border-radius: 999px; padding: 3px 12px; font-size: 13px; font-weight: 600; text-decoration: none; }
    .note { background: var(--sand-soft); border-left: 4px solid var(--warn); padding: 12px 16px; border-radius: 8px; font-size: 14px; color: var(--muted); }
    .prose { font-size: 17px; }
    .prose.page img { max-height: 440px; width: auto; display: block; margin: 12px 0; }
    .prose table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 15px; }
    .prose th, .prose td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
    .prose th { background: var(--aqua); }
    .prose ul { padding-left: 22px; }
    .prose li { margin: 4px 0; }
    .prose blockquote { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--blue); background: #fff; }
    section.band { padding: 48px 0; }
    section.band.white { background: #fff; }
    .waves { height: 28px; background: radial-gradient(circle at 14px -6px, transparent 16px, var(--aqua) 17px) 0 0/28px 28px repeat-x; }
    footer.site { background: var(--navy); color: #DDEFF3; padding: 40px 0 24px; margin-top: 56px; font-size: 15px; }
    footer.site a { color: #fff; }
    footer.site .cols { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    footer.site h4 { color: #fff; margin: 0 0 8px; }
    .breadcrumb { font-size: 14px; color: var(--muted); margin: 18px 0; }
    .breadcrumb a { color: var(--muted); }
    .wa-float { position: fixed; right: 16px; bottom: 16px; background: #25D366; color: #fff; border-radius: 999px; padding: 12px 18px; font-weight: 600; text-decoration: none; box-shadow: 0 6px 20px rgba(0,0,0,.18); z-index: 20; }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">
        <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 28V16a12 12 0 0 1 24 0v12z" fill="#2457A6"/><path d="M10 28v-8a6 6 0 0 1 12 0v8z" fill="#fff"/><path d="M0 28h32v4H0z" fill="#1C9DB0"/></svg>
        Di Trú <span>Síp</span>
      </a>
      <nav class="main" aria-label="Menu chính">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Menu">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div class="cols">
        <div>
          <h4>Di Trú Síp</h4>
          <p>Tư vấn thường trú Síp diện đầu tư bất động sản 6(2), tour khảo sát, bất động sản và an cư tại Paphos.</p>
        </div>
        <div>
          <h4>Liên hệ</h4>
          <p>Síp: <a href={`tel:${contact.phone_cy?.replace(/\s/g, '')}`}>{contact.phone_cy}</a><br />
          Việt Nam: <a href={`tel:${contact.phone_vn?.replace(/\s/g, '')}`}>{contact.phone_vn}</a><br />
          Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>
        <div>
          <h4>Văn phòng</h4>
          <p>{contact.offices?.map((o: any) => <>{o.city}: {o.address}<br /></>)}</p>
        </div>
        <div>
          <h4>Theo dõi</h4>
          <p><a href={social.youtube} rel="noopener">YouTube Cường Đảo Síp</a><br /><a href={social.facebook} rel="noopener">Facebook Cường Đảo Síp</a></p>
        </div>
      </div>
      <p style="margin-top:24px;font-size:13px;opacity:.8">Thông tin trên web mang tính tham khảo, không phải tư vấn pháp lý. Điều kiện và chi phí có thể thay đổi; đội ngũ xác nhận theo văn bản hiện hành khi tư vấn. © {new Date().getFullYear()} Di Trú Síp · <a href="/chinh-sach-quyen-rieng-tu/">Chính sách quyền riêng tư</a> · <a href="/dieu-khoan/">Điều khoản</a> · <a href="/ho-tro/">Hỗ trợ</a> · <a href="/xoa-tai-khoan/">Xoá tài khoản</a></p>
    </div>
  </footer>
  <a class="wa-float" href={contact.whatsapp} rel="noopener">WhatsApp</a>
  <Assistant />
</body>
</html>
